[{"id":"println","category":"Printing & Output","title":"println! (Print Line)","badge":"Macro","unit":"Unit 1: Getting Started","lessonId":"hello-world","lessonNumber":"1.1","summary":"Prints text or data to the screen, then automatically moves down to a new line.","explanation":"println! is a built-in helper called a macro (signaled by the !). It takes text wrapped in double quotes and displays it in the terminal. Once the message finishes printing, it automatically starts a fresh line.","syntax":"println!(\"text to display\");\nprintln!(\"Value is: {}\", value);","example":"fn main() {\n    println!(\"Hello, World!\");\n    println!(\"Welcome to Learn4Free!\");\n}","output":"Hello, World!\nWelcome to Learn4Free!","terms":["println!","macro","string","statement","semicolon"]},{"id":"print","category":"Printing & Output","title":"print! (Print Same Line)","badge":"Macro","unit":"Unit 1: Getting Started","lessonId":"multiple-lines","lessonNumber":"1.2","summary":"Prints text to the screen without jumping to a new line.","explanation":"Unlike println!, print! leaves the cursor exactly where the text ended. The very next print statement will continue right after it on the same line.","syntax":"print!(\"text to display\");","example":"fn main() {\n    print!(\"Loading... \");\n    println!(\"Done!\");\n}","output":"Loading... Done!","terms":["print!","macro","new line"]},{"id":"escape-sequences","category":"Printing & Output","title":"Escape Sequences (\\n, \\t)","badge":"Syntax","unit":"Unit 1: Getting Started","lessonId":"multiple-lines","lessonNumber":"1.2","summary":"Special backslash codes inside quotes that represent characters you cannot easily type.","explanation":"Inside a string, writing \\n creates a new line (like hitting Enter), and \\t creates a tab gap. Writing \\\" lets you put quote marks inside a string, and \\\\ prints a literal backslash.","syntax":"\"First line\\nSecond line\"\n\"Col 1\\tCol 2\"","example":"fn main() {\n    println!(\"Item:\\tPrice:\\nApples\\t$1.50\");\n}","output":"Item:\tPrice:\nApples\t$1.50","terms":["escape sequence","\\n","\\t"]},{"id":"placeholders","category":"Printing & Output","title":"{} Format Placeholders","badge":"Syntax","unit":"Unit 1: Getting Started","lessonId":"placeholders","lessonNumber":"1.3","summary":"A pair of curly braces inside a string that acts like a fill-in-the-blank.","explanation":"When printing, {} marks where a variable or value should be inserted. Rust fills the blanks with the values listed after the string, in the exact order you provide them.","syntax":"println!(\"Hello, {}! You are {} years old.\", name, age);","example":"fn main() {\n    let language = \"Rust\";\n    let year = 2015;\n    println!(\"{} was released in {}.\", language, year);\n}","output":"Rust was released in 2015.","terms":["{}","format string","placeholder","variable"]},{"id":"number-formatting","category":"Printing & Output","title":"Format Specifiers ({:.2}, {:04})","badge":"Syntax","unit":"Unit 1: Getting Started","lessonId":"format-numbers","lessonNumber":"1.4","summary":"Rules inside {} that control decimal precision, width, padding, and alignment.","explanation":"Adding a colon inside braces tells Rust how to format the data: {:.2} limits a decimal to 2 places (rounded), {:5} pads with spaces to width 5, and {:04} pads with leading zeros.","syntax":"println!(\"{:.2}\", 3.14159); // 3.14\nprintln!(\"{:05}\", 42);    // 00042","example":"fn main() {\n    let price = 9.998;\n    let score = 7;\n    println!(\"Price: ${:.2}\", price);\n    println!(\"ID: {:04}\", score);\n}","output":"Price: $10.00\nID: 0007","terms":["format specifier","precision","padding","float"]},{"id":"comments","category":"Printing & Output","title":"// Comments","badge":"Syntax","unit":"Unit 1: Getting Started","lessonId":"hello-world","lessonNumber":"1.1","summary":"Notes written in your code for humans to read; completely ignored by the computer.","explanation":"Any line starting with // is a single-line comment. Rust skips it completely during compilation. Use comments to explain why you wrote something or clarify tricky logic.","syntax":"// This is a comment\n/* Block comment */","example":"fn main() {\n    // Print a welcoming greeting to the user\n    println!(\"Welcome!\");\n}","output":"Welcome!","terms":["comment","compiler"]},{"id":"let-immutable","category":"Variables & Types","title":"let (Immutable Variable)","badge":"Keyword","unit":"Unit 2: Variables & Types","lessonId":"let-bindings","lessonNumber":"2.1","summary":"Creates a named storage box whose value cannot be altered after creation.","explanation":"In Rust, variables are immutable (read-only) by default. Once you assign a value with let, the computer guarantees that value will never unexpectedly change later in your code.","syntax":"let variable_name = value;","example":"fn main() {\n    let apples = 5;\n    let cost_per_apple = 2;\n    println!(\"Total: ${}\", apples * cost_per_apple);\n}","output":"Total: $10","terms":["let","variable","immutable","type"]},{"id":"let-mut","category":"Variables & Types","title":"let mut (Mutable Variable)","badge":"Keyword","unit":"Unit 2: Variables & Types","lessonId":"mutability","lessonNumber":"2.2","summary":"Creates a variable whose stored value CAN be changed and reassigned later.","explanation":"If you need a counter, a game score, or an accumulating total, add the mut keyword after let. This tells Rust you plan to update or reassign the value as your program runs.","syntax":"let mut count = 0;\ncount += 1;\ncount = 10;","example":"fn main() {\n    let mut score = 100;\n    println!(\"Initial: {}\", score);\n    score += 50;\n    println!(\"Updated: {}\", score);\n}","output":"Initial: 100\nUpdated: 150","terms":["mut","mutable","assignment","reassignment"]},{"id":"shadowing","category":"Variables & Types","title":"Variable Shadowing","badge":"Concept","unit":"Unit 2: Variables & Types","lessonId":"shadowing","lessonNumber":"2.3","summary":"Declaring a new variable with the exact same name as a previous one in the same scope.","explanation":"Shadowing creates a fresh variable that hides the earlier one. It allows you to perform transformations on a value (or even change its data type) while reusing a clear name.","syntax":"let x = 5;\nlet x = x + 1;\nlet spaces = \"   \";\nlet spaces = spaces.len();","example":"fn main() {\n    let text = \"42\";\n    let text = text.len(); // changed type from &str to number!\n    println!(\"Length: {}\", text);\n}","output":"Length: 2","terms":["shadowing","scope","rebinding"]},{"id":"integers","category":"Variables & Types","title":"Integer Types (i32, u32, usize)","badge":"Type","unit":"Unit 2: Variables & Types","lessonId":"integer-math","lessonNumber":"2.4","summary":"Whole numbers without fractions, both signed (can be negative) and unsigned (positive only).","explanation":"Rust provides integers of specific bit sizes: i32 is the standard signed 32-bit integer (-2 billion to +2 billion). u32 is unsigned (0 to 4 billion). usize matches your computer pointer size and is used for indexing collections.","syntax":"let a: i32 = -42;\nlet b: u32 = 100;\nlet count: usize = 10;","example":"fn main() {\n    let positive: u32 = 250;\n    let negative: i32 = -50;\n    println!(\"u32: {}, i32: {}\", positive, negative);\n}","output":"u32: 250, i32: -50","terms":["integer","i32","u32","usize","signed","unsigned"]},{"id":"floats-and-casting","category":"Variables & Types","title":"Floats & Casting (as f64)","badge":"Type","unit":"Unit 2: Variables & Types","lessonId":"floats-casting","lessonNumber":"2.5","summary":"Numbers with fractional points (f64) and converting between types with as.","explanation":"f64 is a 64-bit floating point number (e.g. 3.14). Rust never converts types automatically: you cannot add an integer to a float directly. Use the as keyword (e.g. n as f64) to explicitly cast between types.","syntax":"let pi: f64 = 3.14159;\nlet total: i32 = 10;\nlet avg = total as f64 / 3.0;","example":"fn main() {\n    let sum = 25;\n    let count = 4;\n    let average = sum as f64 / count as f64;\n    println!(\"Average: {:.2}\", average);\n}","output":"Average: 6.25","terms":["float","f64","casting","as"]},{"id":"tuples","category":"Variables & Types","title":"Tuples ((a, b, c))","badge":"Type","unit":"Unit 2: Variables & Types","lessonId":"tuples-arrays","lessonNumber":"2.6","summary":"A fixed-size group of values where each element can have a completely different type.","explanation":"Tuples bundle multiple pieces of data into a single compound value. You access elements using dot notation with an index (.0, .1) or unpack all elements at once with destructuring.","syntax":"let item = (\"pencil\", 0.99, 12);\nlet name = item.0;\nlet (n, price, qty) = item;","example":"fn main() {\n    let player = (\"Alice\", 95, true);\n    println!(\"Name: {}, Score: {}\", player.0, player.1);\n    let (name, score, is_active) = player;\n    println!(\"Active: {}\", is_active);\n}","output":"Name: Alice, Score: 95\nActive: true","terms":["tuple","destructuring","indexing"]},{"id":"arrays","category":"Variables & Types","title":"Arrays ([T; N])","badge":"Type","unit":"Unit 2: Variables & Types","lessonId":"tuples-arrays","lessonNumber":"2.6","summary":"A fixed-size sequence of elements where every single item has the exact same type.","explanation":"Arrays in Rust have a fixed length known at compile time. They are stored directly on the stack for speed. Access elements using square brackets starting at zero: arr[0].","syntax":"let numbers = [10, 20, 30, 40];\nlet first = numbers[0];\nlet zeroes = [0; 5]; // [0, 0, 0, 0, 0]","example":"fn main() {\n    let primes = [2, 3, 5, 7, 11];\n    println!(\"First prime: {}\", primes[0]);\n    println!(\"Number of primes: {}\", primes.len());\n}","output":"First prime: 2\nNumber of primes: 5","terms":["array","element","index","len"]},{"id":"if-else","category":"Control Flow","title":"if and else","badge":"Keyword","unit":"Unit 3: Control Flow","lessonId":"if-else","lessonNumber":"3.1","summary":"Runs a block of code only when a condition evaluates to true.","explanation":"An if statement checks a boolean condition. If true, its block runs. If false, it skips that block or runs the optional else block. Conditions in Rust do not need parentheses.","syntax":"if condition {\n    // runs if true\n} else {\n    // runs if false\n}","example":"fn main() {\n    let age = 18;\n    if age >= 18 {\n        println!(\"Eligible to vote!\");\n    } else {\n        println!(\"Too young to vote.\");\n    }\n}","output":"Eligible to vote!","terms":["if","else","condition","branch","boolean"]},{"id":"if-expression","category":"Control Flow","title":"if as an Expression","badge":"Concept","unit":"Unit 3: Control Flow","lessonId":"letter-grades","lessonNumber":"3.2","summary":"Assigns the result of an if/else block directly to a variable.","explanation":"In Rust, if is an expression that produces a value. Omit the semicolon on the final line of each branch to return that value. Both branches must return the exact same data type.","syntax":"let result = if condition { value_a } else { value_b };","example":"fn main() {\n    let score = 85;\n    let grade = if score >= 90 { \"A\" } else if score >= 80 { \"B\" } else { \"C\" };\n    println!(\"Grade: {}\", grade);\n}","output":"Grade: B","terms":["expression","branch","return value"]},{"id":"loop-break","category":"Control Flow","title":"loop and break","badge":"Keyword","unit":"Unit 3: Control Flow","lessonId":"loop-break","lessonNumber":"3.3","summary":"Repeats a code block endlessly until explicitly stopped with break.","explanation":"Rust provides loop for infinite loops. You exit the loop by calling break. You can also return a value from the loop by writing break followed by a value: break value;.","syntax":"loop {\n    if done {\n        break;\n    }\n}","example":"fn main() {\n    let mut n = 1;\n    loop {\n        print!(\"{} \", n);\n        if n == 5 { break; }\n        n += 1;\n    }\n    println!();\n}","output":"1 2 3 4 5","terms":["loop","break","infinite loop"]},{"id":"while-loops","category":"Control Flow","title":"while Loop","badge":"Keyword","unit":"Unit 3: Control Flow","lessonId":"while-loops","lessonNumber":"3.4","summary":"Repeats a code block as long as a condition remains true.","explanation":"Before every pass, while checks its condition. If true, the body executes. The moment the condition becomes false, the loop ends. Make sure your loop modifies a variable so it does not run forever!","syntax":"while condition {\n    // repeated work\n}","example":"fn main() {\n    let mut count = 3;\n    while count > 0 {\n        println!(\"{}...\", count);\n        count -= 1;\n    }\n    println!(\"Blast off!\");\n}","output":"3...\n2...\n1...\nBlast off!","terms":["while","condition","counter"]},{"id":"for-ranges","category":"Control Flow","title":"for Loops & Ranges (0..n, 0..=n)","badge":"Keyword","unit":"Unit 3: Control Flow","lessonId":"for-ranges","lessonNumber":"3.5","summary":"Loops over every number in a range or every item in a collection.","explanation":"0..5 creates a range from 0 up to 4 (5 is excluded). 0..=5 is inclusive (includes 5). for loops in Rust are safe, fast, and prevent out-of-bounds indexing errors.","syntax":"for i in 0..5 { /* 0, 1, 2, 3, 4 */ }\nfor i in 0..=5 { /* 0, 1, 2, 3, 4, 5 */ }","example":"fn main() {\n    for i in 1..=4 {\n        println!(\"Count: {}\", i);\n    }\n}","output":"Count: 1\nCount: 2\nCount: 3\nCount: 4","terms":["for","range","exclusive","inclusive","iteration"]},{"id":"match-expression","category":"Control Flow","title":"match Expression","badge":"Keyword","unit":"Unit 3: Control Flow","lessonId":"match-expressions","lessonNumber":"3.7","summary":"Pattern matches a value against multiple possible arms; every possibility must be handled.","explanation":"match is a powerful alternative to long if/else chains. Rust enforces exhaustiveness: every single possible value must have a matching arm. Use _ as a wildcard catch-all for any unlisted values.","syntax":"match value {\n    1 => println!(\"One\"),\n    2 | 3 => println!(\"Two or three\"),\n    _ => println!(\"Other\"),\n}","example":"fn main() {\n    let dice_roll = 6;\n    match dice_roll {\n        1 => println!(\"Critical failure!\"),\n        6 => println!(\"Critical success!\"),\n        _ => println!(\"Normal roll.\"),\n    }\n}","output":"Critical success!","terms":["match","pattern","arm","wildcard","exhaustive"]},{"id":"fn-declaration","category":"Functions","title":"fn (Function Declaration)","badge":"Keyword","unit":"Unit 4: Functions","lessonId":"fn-square","lessonNumber":"4.1","summary":"Defines a reusable, named sequence of instructions with inputs and outputs.","explanation":"Functions bundle instructions under a name. Parameters are declared with explicit types (name: Type). The return type is declared with an arrow: -> Type. You call a function with its name followed by parentheses: square(5).","syntax":"fn function_name(param1: i32, param2: i32) -> i32 {\n    // body\n}","example":"fn square(n: i32) -> i32 {\n    n * n // no semicolon = return value\n}\n\nfn main() {\n    let result = square(5);\n    println!(\"Square of 5 is {}\", result);\n}","output":"Square of 5 is 25","terms":["fn","function","parameter","argument","return type"]},{"id":"implicit-return","category":"Functions","title":"Implicit Return vs return","badge":"Concept","unit":"Unit 4: Functions","lessonId":"fn-square","lessonNumber":"4.1","summary":"Leaving off the final semicolon returns a value; the return keyword is for early exit.","explanation":"In Rust, blocks evaluate to the value of their last expression. If you omit the semicolon on the final line of a function, that expression is automatically returned. Use the return keyword only when you need an early exit.","syntax":"fn add(a: i32, b: i32) -> i32 {\n    a + b // implicit return\n}\nfn check(n: i32) -> bool {\n    if n < 0 { return false; } // early exit\n    true\n}","example":"fn max2(a: i32, b: i32) -> i32 {\n    if a > b { a } else { b }\n}\nfn main() {\n    println!(\"Max: {}\", max2(10, 42));\n}","output":"Max: 42","terms":["return","expression","statement","semicolon"]},{"id":"recursion","category":"Functions","title":"Recursion","badge":"Concept","unit":"Unit 4: Functions","lessonId":"fn-factorial","lessonNumber":"4.4","summary":"A function that solves a problem by calling itself with a smaller input.","explanation":"Recursive functions need a base case (stopping condition) so they do not loop forever. Once the base case is hit, the calculations unwind and produce the final result.","syntax":"fn factorial(n: u64) -> u64 {\n    if n <= 1 { 1 } else { n * factorial(n - 1) }\n}","example":"fn factorial(n: u64) -> u64 {\n    if n <= 1 { 1 } else { n * factorial(n - 1) }\n}\nfn main() {\n    println!(\"5! = {}\", factorial(5));\n}","output":"5! = 120","terms":["recursion","base case","call stack"]},{"id":"ownership-moves","category":"Ownership & Memory","title":"Ownership and Moves","badge":"Concept","unit":"Unit 5: Ownership & Borrowing","lessonId":"own-move-clone","lessonNumber":"5.1","summary":"Each value in Rust has exactly one owner; passing it transfers ownership (moves).","explanation":"Ownership is Rust's core superpower for memory safety without a garbage collector. When a variable goes out of scope, its memory is freed automatically. When non-primitive types are assigned or passed to a function, ownership moves, and the original variable cannot be used.","syntax":"let s1 = String::from(\"hello\");\nlet s2 = s1; // s1 moved to s2; s1 is now invalid","example":"fn main() {\n    let s1 = String::from(\"Learn4Free\");\n    let s2 = s1.clone(); // deep copy\n    println!(\"s1: {}, s2: {}\", s1, s2);\n}","output":"s1: Learn4Free, s2: Learn4Free","terms":["ownership","owner","move","drop","clone"]},{"id":"references-borrowing","category":"Ownership & Memory","title":"References & Borrowing (&T)","badge":"Syntax","unit":"Unit 5: Ownership & Borrowing","lessonId":"own-borrow","lessonNumber":"5.2","summary":"Allows reading a value without taking ownership, created with the & symbol.","explanation":"Borrowing lets you pass data to a function or variable temporarily without transferring ownership. The owner retains the value once the borrow finishes.","syntax":"fn calculate_len(s: &String) -> usize {\n    s.len()\n}","example":"fn print_message(msg: &String) {\n    println!(\"Message: {}\", msg);\n}\nfn main() {\n    let s = String::from(\"Rust rules\");\n    print_message(&s);\n    println!(\"Still own s: {}\", s);\n}","output":"Message: Rust rules\nStill own s: Rust rules","terms":["reference","borrow","&","immutable reference"]},{"id":"mutable-references","category":"Ownership & Memory","title":"Mutable References (&mut T)","badge":"Syntax","unit":"Unit 5: Ownership & Borrowing","lessonId":"own-mut-ref","lessonNumber":"5.3","summary":"Allows modifying a borrowed value; you may only have ONE mutable reference at a time.","explanation":"If you need to change borrowed data, use &mut. To prevent data corruption, Rust enforces that you can either have any number of immutable references (&T) OR exactly one mutable reference (&mut T) at any moment.","syntax":"fn append_word(s: &mut String) {\n    s.push_str(\" world\");\n}","example":"fn add_one(n: &mut i32) {\n    *n += 1;\n}\nfn main() {\n    let mut val = 10;\n    add_one(&mut val);\n    println!(\"Updated: {}\", val);\n}","output":"Updated: 11","terms":["&mut","mutable reference","dereference","data race"]},{"id":"slices","category":"Ownership & Memory","title":"Slices (&[T], &str)","badge":"Type","unit":"Unit 5: Ownership & Borrowing","lessonId":"own-slices","lessonNumber":"5.4","summary":"A borrowed view into a contiguous sequence of elements without copying them.","explanation":"A slice references part of an array, vector, or string using a range &[start..end]. It contains a pointer to the data and a length, giving high-performance access without allocating new memory.","syntax":"let arr = [1, 2, 3, 4, 5];\nlet slice = &arr[1..4]; // [2, 3, 4]","example":"fn main() {\n    let words = [\"Rust\", \"is\", \"safe\", \"and\", \"fast\"];\n    let sub = &words[2..5];\n    println!(\"Slice: {:?}\", sub);\n}","output":"Slice: [\"safe\", \"and\", \"fast\"]","terms":["slice","&[T]","&str","range"]},{"id":"structs","category":"Structs & Enums","title":"struct (Custom Data Types)","badge":"Keyword","unit":"Unit 6: Structs & Enums","lessonId":"struct-rect","lessonNumber":"6.1","summary":"Groups multiple related named fields into a single custom data structure.","explanation":"A struct is like a blueprint for an object. You define named fields and their types. You then instantiate the struct by providing values for each field, and access them with dot notation.","syntax":"struct Rectangle {\n    width: u32,\n    height: u32,\n}\nlet r = Rectangle { width: 30, height: 50 };","example":"struct User {\n    username: String,\n    active: bool,\n}\nfn main() {\n    let u = User { username: String::from(\"ferris\"), active: true };\n    println!(\"User {} is active: {}\", u.username, u.active);\n}","output":"User ferris is active: true","terms":["struct","field","instance","dot notation"]},{"id":"impl-methods","category":"Structs & Enums","title":"impl and Methods (&self)","badge":"Keyword","unit":"Unit 6: Structs & Enums","lessonId":"struct-rect","lessonNumber":"6.1","summary":"Defines methods attached to a struct; &self refers to the instance calling the method.","explanation":"Use an impl block to attach behavior (methods) to your struct. The first parameter is &self (borrowing the instance) or &mut self (if modifying). Methods are called with dot syntax: rect.area().","syntax":"impl Rectangle {\n    fn area(&self) -> u32 {\n        self.width * self.height\n    }\n}","example":"struct Circle { radius: f64 }\nimpl Circle {\n    fn area(&self) -> f64 { 3.14159 * self.radius * self.radius }\n}\nfn main() {\n    let c = Circle { radius: 2.0 };\n    println!(\"Area: {:.2}\", c.area());\n}","output":"Area: 12.57","terms":["impl","method","&self","&mut self"]},{"id":"enums","category":"Structs & Enums","title":"enum (Enumerations)","badge":"Keyword","unit":"Unit 6: Structs & Enums","lessonId":"enum-match","lessonNumber":"6.2","summary":"A custom type that can be exactly ONE of several distinct possible variants.","explanation":"Enums let you enumerate all possible states or shapes of data. Variants can be bare names or hold nested data. You inspect which variant an enum is using match.","syntax":"enum Direction {\n    North,\n    South,\n    East,\n    West,\n}","example":"enum TrafficLight {\n    Red,\n    Yellow,\n    Green,\n}\nfn main() {\n    let light = TrafficLight::Green;\n    match light {\n        TrafficLight::Red => println!(\"Stop!\"),\n        TrafficLight::Yellow => println!(\"Slow down!\"),\n        TrafficLight::Green => println!(\"Go!\"),\n    }\n}","output":"Go!","terms":["enum","variant","match","exhaustive"]},{"id":"option","category":"Structs & Enums","title":"Option<T> (Some and None)","badge":"Type","unit":"Unit 6: Structs & Enums","lessonId":"enum-option","lessonNumber":"6.3","summary":"A built-in enum that represents a value that might exist (Some) or might be absent (None).","explanation":"Rust does not have null or undefined! Instead, Option<T> explicitly distinguishes between a present value (Some(value)) and an absent value (None). The compiler forces you to handle the None case.","syntax":"let present: Option<i32> = Some(42);\nlet absent: Option<i32> = None;","example":"fn find_word(list: &[&str], target: &str) -> Option<usize> {\n    for (i, &w) in list.iter().enumerate() {\n        if w == target { return Some(i); }\n    }\n    None\n}\nfn main() {\n    let fruits = [\"apple\", \"banana\", \"orange\"];\n    match find_word(&fruits, \"banana\") {\n        Some(idx) => println!(\"Found at index {}\", idx),\n        None => println!(\"Not found\"),\n    }\n}","output":"Found at index 1","terms":["Option","Some","None","null safety"]},{"id":"vectors","category":"Collections","title":"Vec<T> (Vectors & vec![])","badge":"Collection","unit":"Unit 7: Collections","lessonId":"vec-basics","lessonNumber":"7.1","summary":"A resizable, heap-allocated list that can grow and shrink dynamically.","explanation":"Vectors store elements of the same type sequentially on the heap. You create an empty vector with Vec::new() or use the convenient vec![1, 2, 3] macro. Use .push() to append and .pop() to remove.","syntax":"let mut v = Vec::new();\nv.push(10);\nlet numbers = vec![1, 2, 3, 4];","example":"fn main() {\n    let mut list = vec![10, 20];\n    list.push(30);\n    println!(\"Vector: {:?}, length: {}\", list, list.len());\n}","output":"Vector: [10, 20, 30], length: 3","terms":["Vec","vector","vec!","push","pop","heap"]},{"id":"strings","category":"Collections","title":"String vs &str","badge":"Type","unit":"Unit 7: Collections","lessonId":"string-palindrome","lessonNumber":"7.3","summary":"String is an owned, growable heap text; &str is a borrowed string slice.","explanation":"String owns its memory and can be mutated with .push_str(). &str is an immutable borrowed reference to a string stored somewhere else (like in the binary or inside a String).","syntax":"let mut s = String::from(\"Hello\");\ns.push_str(\", world!\");\nlet slice: &str = &s[0..5];","example":"fn main() {\n    let mut msg = String::from(\"Hello\");\n    msg.push_str(\" Rustaceans\");\n    println!(\"{}\", msg);\n}","output":"Hello Rustaceans","terms":["String","&str","push_str","borrow"]},{"id":"hashmaps","category":"Collections","title":"HashMap<K, V>","badge":"Collection","unit":"Unit 7: Collections","lessonId":"hashmap-count","lessonNumber":"7.4","summary":"Stores key-value pairs with fast lookup by key using a hash function.","explanation":"A HashMap maps unique keys to values. Use .insert(k, v) to add, .get(&k) to retrieve (returns Option<&V>), and .contains_key(&k) to check existence.","syntax":"use std::collections::HashMap;\nlet mut map = HashMap::new();\nmap.insert(\"key\", 100);\nlet val = map.get(\"key\");","example":"use std::collections::HashMap;\nfn main() {\n    let mut scores = HashMap::new();\n    scores.insert(\"Blue\", 10);\n    scores.insert(\"Yellow\", 25);\n    println!(\"Blue score: {:?}\", scores.get(\"Blue\"));\n}","output":"Blue score: Some(10)","terms":["HashMap","key","value","insert","get"]},{"id":"iterators","category":"Collections","title":"Iterators (.iter(), .map(), .filter())","badge":"Concept","unit":"Unit 7: Collections","lessonId":"iterators","lessonNumber":"7.5","summary":"Steps through sequences item by item with zero-cost functional transformations.","explanation":"Iterators produce items on demand. Chain methods like .map() to transform values, .filter() to select items, and .collect() to gather results back into a collection.","syntax":"let doubled: Vec<i32> = numbers.iter().map(|x| x * 2).collect();","example":"fn main() {\n    let nums = vec![1, 2, 3, 4, 5];\n    let evens: Vec<i32> = nums.into_iter().filter(|x| x % 2 == 0).collect();\n    println!(\"Evens: {:?}\", evens);\n}","output":"Evens: [2, 4]","terms":["iterator","iter","map","filter","collect","closure"]},{"id":"result","category":"Error Handling & Traits","title":"Result<T, E> (Ok and Err)","badge":"Type","unit":"Unit 8: Error Handling & Traits","lessonId":"result-basics","lessonNumber":"8.1","summary":"An enum used for recoverable errors: either Ok(value) on success or Err(error) on failure.","explanation":"Functions that can fail return Result<T, E>. Unlike languages with exceptions that crash silently, Rust forces you to inspect both the Ok and Err paths before accessing the inner value.","syntax":"enum Result<T, E> {\n    Ok(T),\n    Err(E),\n}","example":"fn parse_num(s: &str) -> Result<i32, String> {\n    match s.parse::<i32>() {\n        Ok(n) => Ok(n),\n        Err(_) => Err(\"Invalid number\".to_string()),\n    }\n}\nfn main() {\n    println!(\"{:?}\", parse_num(\"42\"));\n    println!(\"{:?}\", parse_num(\"abc\"));\n}","output":"Ok(42)\nErr(\"Invalid number\")","terms":["Result","Ok","Err","recoverable error"]},{"id":"question-mark","category":"Error Handling & Traits","title":"? Operator (Error Propagation)","badge":"Operator","unit":"Unit 8: Error Handling & Traits","lessonId":"result-question","lessonNumber":"8.2","summary":"Unwraps Ok values, or immediately returns the Err from the current function.","explanation":"The ? operator simplifies error handling. Placed after a Result, if the value is Ok, it extracts the value inside. If Err, it immediately returns the Err to the caller.","syntax":"let value = function_that_might_fail()?;","example":"fn parse_pair(a: &str, b: &str) -> Result<(i32, i32), std::num::ParseIntError> {\n    let n1 = a.parse::<i32>()?;\n    let n2 = b.parse::<i32>()?;\n    Ok((n1, n2))\n}\nfn main() {\n    println!(\"{:?}\", parse_pair(\"10\", \"20\"));\n}","output":"Ok((10, 20))","terms":["?","error propagation","unwrap","Result"]},{"id":"traits","category":"Error Handling & Traits","title":"trait (Shared Interfaces)","badge":"Keyword","unit":"Unit 8: Error Handling & Traits","lessonId":"traits","lessonNumber":"8.3","summary":"Defines a contract of methods that multiple different types can implement.","explanation":"A trait specifies what functionality a type must offer. It is Rust's version of an interface. Different structs can implement the same trait, allowing generic code to work across different types.","syntax":"trait Summarize {\n    fn summary(&self) -> String;\n}\nimpl Summarize for Article {\n    fn summary(&self) -> String { ... }\n}","example":"trait Greet {\n    fn greet(&self) -> String;\n}\nstruct Human;\nimpl Greet for Human {\n    fn greet(&self) -> String { \"Hello!\".to_string() }\n}\nfn main() {\n    let h = Human;\n    println!(\"{}\", h.greet());\n}","output":"Hello!","terms":["trait","impl","interface","polymorphism"]},{"id":"generics","category":"Error Handling & Traits","title":"Generics (<T>) & Trait Bounds","badge":"Concept","unit":"Unit 8: Error Handling & Traits","lessonId":"generics","lessonNumber":"8.4","summary":"Writes code with placeholder types that works safely with any concrete type.","explanation":"Generics avoid repeating code for different types. <T> stands for any type. Trait bounds (like <T: PartialOrd>) specify what capabilities the type must have so the function can run safely.","syntax":"fn print_val<T: std::fmt::Display>(val: T) {\n    println!(\"{}\", val);\n}","example":"fn get_first<T: Copy>(list: &[T]) -> T {\n    list[0]\n}\nfn main() {\n    let nums = [10, 20, 30];\n    let words = [\"alpha\", \"beta\"];\n    println!(\"First num: {}\", get_first(&nums));\n    println!(\"First word: {}\", get_first(&words));\n}","output":"First num: 10\nFirst word: alpha","terms":["generic","T","trait bound","monomorphization"]}]